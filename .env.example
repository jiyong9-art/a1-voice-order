# ============================================================
# 에이원코리아(A1) 음성 업무 오더 - 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (Vercel은 대시보드에 입력)
# 실제 키가 담긴 .env.local 은 절대 GitHub에 올리지 마세요.
# ============================================================

# 1) 팀 공용 비밀번호 (필수) — 외부인이 API 크레딧을 쓰지 못하게 막습니다.
#    예: inu-2026-order  (직원에게만 공유)
APP_PASSCODE=

# 2) 로그인 쿠키 서명 키 (선택 · 배포 시 권장)
#    아무 길고 무작위한 문자열. 비우면 APP_PASSCODE로 대신 서명합니다.
APP_SESSION_SECRET=

# 3) 팀원 이름 목록 (선택) — 로그인 화면 선택지와 담당자 매칭에 사용
#    기본값: 문지용, 이광훈, 송현준, 백남우, 김남국, 한원석, 차정호, 유병은
TEAM_MEMBERS=문지용,이광훈,송현준,백남우,김남국,한원석,차정호,유병은

# 4) 회사 고유명사 사전 (선택) — 음성 인식 정확도를 올립니다.
#    기본값: 에이원코리아, A1, 에이원, 에이팩스미디어, 인유, 문지용, 이광훈, 송현준, 백남우, 김남국, 한원석, 차정호, 유병은, 보험, 설계사, 약관, 후유장해 ...
COMPANY_VOCABULARY=에이원코리아, 에이팩스미디어, 인유, 아이앤유

# 5) OpenAI (필수) https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 음성 변환 모델 (기본 gpt-4o-transcribe · 실패 시 whisper-1 자동 재시도)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# 업무 정리 모델 (기본 gpt-4o-mini · 원하면 gpt-4.1, gpt-5 등으로 변경)
OPENAI_CHAT_MODEL=gpt-4o-mini

# 6) Google Sheets 자동 기록 (권장)
#    스프레드시트 주소의 /d/ 와 /edit 사이 문자열
GOOGLE_SPREADSHEET_ID=
#    서비스 계정 JSON 키 파일 내용을 한 줄로 통째로 붙여넣기
#    예: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=
#    (선택) 시트 바로 열기 링크. 비우면 ID로 자동 생성
GOOGLE_SPREADSHEET_URL=

# 7) 메일 알림 (선택 · 둘 중 하나만 있으면 됩니다)
#    (A) Resend — https://resend.com  (도메인 인증 전에는 본인 메일로만 발송 가능)
RESEND_API_KEY=
MAIL_FROM=에이원 업무오더 <onboarding@resend.dev>
#    (B) SMTP — 네이버/지메일/회사 메일 계정
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
#    통화요약 알림을 받을 대표 메일 (고정 수신자)
NOTIFY_EMAIL=contact@inu.ai.kr

# 8) 테스트용 모의 모드 (선택)
#    true 로 두면 OpenAI 호출 없이 예시 데이터로 화면·시트 연동을 시험합니다.
MOCK_AI=false
