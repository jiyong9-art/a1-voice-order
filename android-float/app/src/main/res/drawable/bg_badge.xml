<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.8 플로팅 배지: 반투명 둥근 배지.
  - 뒤 화면이 비쳐 보이되(약 80% 불투명) A1 글자가 또렷하게 읽힌다.
  - 얇은 흰 테두리로 밝은 화면에서도 경계가 보인다(예전 '귀신처럼 둥둥 뜨는 글자' 해결).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#D91E2E4A"
        android:endColor="#CC0F1B2E"/>
    <stroke android:width="1dp" android:color="#59FFFFFF"/>
</shape>
