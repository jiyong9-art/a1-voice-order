<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/popup_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A1 음성"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/popup_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/popup_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="12sp"/>

    <ProgressBar
        android:id="@+id/popup_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:indeterminate="true"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/popup_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:minLines="4"
        android:maxLines="10"
        android:maxHeight="240dp"
        android:scrollbars="vertical"
        android:gravity="top|start"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="16sp"
        android:lineSpacingExtra="3dp"
        android:hint="변환된 글이 여기에 표시됩니다"
        android:inputType="textMultiLine|textCapSentences"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/popup_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/popup_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_small"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="닫기"
            android:textColor="@color/brand_blue"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/popup_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_btn_primary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="복사"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
