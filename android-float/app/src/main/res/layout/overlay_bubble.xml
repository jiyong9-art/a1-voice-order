<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/bubble_frame"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 변환(두 번 톡톡) 중에만 보이는 하늘색 테두리 펄스 -->
        <View
            android:id="@+id/bubble_ring"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble_ring"
            android:visibility="gone"/>

        <!-- 평상시: 다크네이비 원 (테두리·그림자 없음) -->
        <View
            android:id="@+id/bubble_circle"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble"/>

        <!-- 평상시 가운데 흰색 A1 (마이크 대신 — 녹음 앱인지 티 안 나게) -->
        <TextView
            android:id="@+id/bubble_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="A1"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            android:contentDescription="A1 음성"/>

        <!-- 녹음 파일 저장 중: A1 대신 조용한 흰색 점 하나 (빨간색 없음) -->
        <View
            android:id="@+id/bubble_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot_white"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/bubble_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"/>
</LinearLayout>
