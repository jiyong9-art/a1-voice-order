<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.7 플로팅 버튼: 동그라미·네모 배경 없이 A1 글자만.
  - 검은 글자(#111111)만 떠 있고, 어두운 화면에서도 읽히도록 아주 은은한 흰색 그림자만 준다.
  - 원/사각 배경은 완전히 투명(없음) — 다른 앱 화면을 가리지 않는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 손가락이 닿는 영역만 56dp 로 작게 — 배경은 투명 -->
    <FrameLayout
        android:id="@+id/bubble_frame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 배경 없음(투명). 예전 원형 배경 자리를 그대로 두되 보이지 않는다. -->
        <View
            android:id="@+id/bubble_circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"/>

        <!-- 말하는 중에만 도는 은은한 테두리 (배경이 아니라 얇은 선) -->
        <View
            android:id="@+id/bubble_ring"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bubble_ring"
            android:visibility="gone"/>

        <!-- 평상시: 검은 A1 글자만 (흰색 그림자는 아주 은은하게) -->
        <TextView
            android:id="@+id/bubble_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="A1"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="#B3FFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:contentDescription="A1 음성"/>

        <!-- 녹음 파일 저장 중: A1 대신 조용한 검은 점 하나 (빨간색 없음) -->
        <View
            android:id="@+id/bubble_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot_dark"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- 상태 안내(두 번 톡톡! · ● 0:03 · 변환 중…) — 아주 작은 알약 -->
    <TextView
        android:id="@+id/bubble_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"/>
</LinearLayout>
